---
// AnnouncementBar.astro - Exact Red Banner matching Oud Attar reference
---
<div class="bg-[#ff2032] text-white py-2 px-4 text-xs relative z-50 flex items-center justify-between shadow-2xs">
  <button class="text-white hover:opacity-80 transition-opacity p-1 cursor-pointer" aria-label="Previous announcement">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <div class="text-center flex-1">
    <a
      href="/sale"
      class="font-['Barlow_Condensed',sans-serif] text-sm sm:text-base font-bold tracking-[0.04em] uppercase underline underline-offset-3 decoration-1 hover:opacity-90 transition-opacity"
    >
      DISCOUNT AT CHECKOUT
    </a>
  </div>

  <button class="text-white hover:opacity-80 transition-opacity p-1 cursor-pointer" aria-label="Next announcement">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
