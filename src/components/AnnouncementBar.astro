---
// AnnouncementBar.astro - Exact Red Banner with Tall Slim Condensed Typography
---
<div class="bg-[#ff2d3b] text-white py-2 px-4 text-xs font-normal relative z-50 flex items-center justify-between shadow-xs">
  <button class="text-white hover:opacity-80 transition-opacity p-1" aria-label="Previous announcement">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <div class="text-center flex-1">
    <a
      href="/sale"
      class="font-['Barlow_Condensed',sans-serif] text-sm sm:text-base font-medium tracking-[0.05em] uppercase underline underline-offset-4 decoration-1 hover:opacity-90 transition-opacity"
    >
      DISCOUNT AT CHECKOUT
    </a>
  </div>

  <button class="text-white hover:opacity-80 transition-opacity p-1" aria-label="Next announcement">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
