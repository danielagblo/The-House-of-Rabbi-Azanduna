---
// Footer.astro - Minimalist Footer matching authentic Oud Attar reference
---
<footer class="bg-white border-t border-gray-200 font-['Barlow_Condensed',sans-serif]">
  <!-- Upper Footer: Clean Navigation Links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-center">
    <div class="flex flex-wrap items-center justify-center gap-x-8 sm:gap-x-12 gap-y-3 text-xs sm:text-[13px] font-medium tracking-[0.1em] uppercase text-gray-800 font-['Barlow',sans-serif]">
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">FAQ</a>
      <a href="/about" class="hover:text-[#ff2d3b] transition-colors">CONTACT US</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">TERMS OF SERVICE</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">PRIVACY POLICY</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">REFUND POLICY</a>
    </div>
  </div>

  <!-- Bottom Strip: Solid Black Bar with Copyright and Payment Icons -->
  <div class="bg-black text-white py-3.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-gray-400 font-['Poppins',sans-serif]">
      <div class="text-center sm:text-left">
        © {new Date().getFullYear()} Rabbi Azanduna Ltd.
      </div>

      {/* Payment Badges Strip */}
      <div class="flex items-center gap-1.5 flex-wrap justify-center">
        <!-- Paystack Badge -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded text-[9px] font-extrabold text-[#00c3f7] h-5 border border-white/20">
          paystack
        </span>

        <!-- Apple Pay -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded text-[9px] font-bold text-black h-5 border border-white/20">
          <svg class="h-3 w-auto" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.7-0.93 2.71 1 .08 2.01-.46 2.63-1.21z"/>
          </svg>
        </span>

        <!-- Google Pay -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded text-[9px] font-bold text-gray-700 h-5 border border-white/20">
          <span class="text-blue-500">G</span><span class="text-red-500">P</span><span class="text-amber-500">a</span><span class="text-green-500">y</span>
        </span>

        <!-- Visa -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded text-[9px] font-black italic text-[#1a1f71] h-5 border border-white/20">
          VISA
        </span>

        <!-- Mastercard -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded h-5 border border-white/20">
          <span class="w-2.5 h-2.5 rounded-full bg-[#eb001b] -mr-1 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#f79e1b] opacity-80 inline-block"></span>
        </span>

        <!-- Amex -->
        <span class="inline-flex items-center justify-center bg-[#006fcf] text-white px-2 py-0.5 rounded text-[9px] font-bold h-5">
          AMEX
        </span>

        <!-- PayPal -->
        <span class="inline-flex items-center justify-center bg-white px-2 py-0.5 rounded text-[9px] font-bold italic text-[#003087] h-5 border border-white/20">
          PayPal
        </span>
      </div>
    </div>
  </div>
</footer>
