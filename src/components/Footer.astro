---
// Footer.astro - Minimalist Footer matching authentic Oud Attar reference
---
<footer class="bg-white border-t border-gray-200 font-['Barlow_Condensed',sans-serif]">
  <!-- Upper Footer: Clean Navigation Links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-center">
    <div class="flex flex-wrap items-center justify-center gap-x-8 sm:gap-x-12 gap-y-3 text-xs sm:text-[13px] font-medium tracking-[0.1em] uppercase text-gray-800 font-['Barlow',sans-serif]">
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">FAQ</a>
      <a href="/about" class="hover:text-[#ff2d3b] transition-colors">CONTACT US</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">TERMS OF SERVICE</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">PRIVACY POLICY</a>
      <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">REFUND POLICY</a>
    </div>
  </div>

  <!-- Bottom Strip: Solid Black Bar with Copyright and Payment Icons -->
  <div class="bg-black text-white py-3.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-gray-400 font-['Poppins',sans-serif]">
      <div class="text-center sm:text-left">
        © {new Date().getFullYear()} Rabbi Azanduna Ltd.
      </div>

      {/* Payment Badges Strip - Exclusively Paystack */}
      <div class="flex items-center gap-2 justify-center sm:justify-end">
        <span class="text-[11px] text-gray-400">Payment Secured by:</span>
        <span class="inline-flex items-center justify-center bg-white px-2.5 py-0.5 rounded text-[10px] font-extrabold text-[#00c3f7] h-5 border border-white/20 tracking-wider">
          paystack
        </span>
      </div>
    </div>
  </div>
</footer>
