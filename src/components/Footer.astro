---
// Footer with store links and accepted payment methods
---
<footer class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex flex-col items-center gap-6">
      <p class="font-['Barlow',sans-serif] text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-gray-500">
        Pay your way
      </p>

      <div class="w-full max-w-3xl">
        <p class="text-center text-[10px] font-semibold uppercase tracking-[0.16em] text-gray-400 mb-2.5">
          Mobile Money · All networks
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 h-8 pl-1.5 pr-2.5 rounded-md bg-[#ffcc00] text-black shadow-xs" title="MTN Mobile Money">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-sm bg-black text-[#ffcc00] text-[8px] font-black leading-none">MTN</span>
            <span class="text-[11px] font-extrabold tracking-wide">MoMo</span>
          </span>
          <span class="inline-flex items-center h-8 px-2.5 rounded-md bg-[#e10600] text-white shadow-xs" title="Telecel Cash">
            <span class="text-[11px] font-extrabold tracking-wide">Telecel Cash</span>
          </span>
          <span class="inline-flex items-center h-8 px-2.5 rounded-md bg-[#0033a0] text-white shadow-xs" title="AirtelTigo Money">
            <span class="text-[11px] font-extrabold tracking-wide">AT Money</span>
          </span>
        </div>
      </div>

      <div class="w-full max-w-3xl">
        <p class="text-center text-[10px] font-semibold uppercase tracking-[0.16em] text-gray-400 mb-2.5">
          Cards
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center justify-center h-8 px-3 rounded-md bg-[#1a1f71] text-white shadow-xs" title="Visa">
            <span class="text-[13px] font-black italic tracking-wider">VISA</span>
          </span>
          <span class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md bg-white border border-gray-200 shadow-xs" title="Mastercard">
            <span class="relative w-6 h-4 shrink-0" aria-hidden="true">
              <span class="absolute left-0 top-0 w-4 h-4 rounded-full bg-[#eb001b]"></span>
              <span class="absolute right-0 top-0 w-4 h-4 rounded-full bg-[#f79e1b] mix-blend-multiply"></span>
            </span>
            <span class="text-[11px] font-bold text-gray-800">Mastercard</span>
          </span>
          <span class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md bg-neutral-900 text-white shadow-xs" title="Debit card">
            <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
              <rect x="0.5" y="0.5" width="15" height="11" rx="1.5" stroke="currentColor"></rect>
              <path d="M0.5 3.5h15" stroke="currentColor"></path>
            </svg>
            <span class="text-[11px] font-bold tracking-wide">Debit Card</span>
          </span>
        </div>
      </div>

      <p class="text-center text-[11px] sm:text-xs text-gray-500 font-['Poppins',sans-serif] max-w-xl leading-relaxed">
        Checkout with MTN MoMo, Telecel Cash, AT Money, Visa, Mastercard, and debit cards. Payments are secured by Paystack.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-10 gap-y-2 text-[11px] sm:text-[12px] font-medium tracking-[0.08em] uppercase text-gray-800 font-['Barlow',sans-serif]">
        <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">FAQ</a>
        <a href="/about" class="hover:text-[#ff2d3b] transition-colors">Contact Us</a>
        <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">Terms of Service</a>
        <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">Privacy Policy</a>
        <a href="/faqs" class="hover:text-[#ff2d3b] transition-colors">Refund Policy</a>
      </div>
    </div>
  </div>

  <div class="bg-black text-white py-3.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-gray-400 font-['Poppins',sans-serif]">
      <div class="text-center sm:text-left">
        © {new Date().getFullYear()} The House of Rabbi Azanduna
      </div>
      <div class="inline-flex items-center gap-2">
        <span>Secured by</span>
        <span class="inline-flex items-center justify-center bg-white px-2.5 py-0.5 rounded text-[10px] font-extrabold text-[#00c3f7] h-5 tracking-wider">
          paystack
        </span>
      </div>
    </div>
  </div>
</footer>
