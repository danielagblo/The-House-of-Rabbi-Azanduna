---
import Layout from '../../layouts/Layout.astro';
import { ProductDetailView } from '../../components/ProductDetailView';
import { FALLBACK_PRODUCTS } from '../../data/fallbackData';

export async function getStaticPaths() {
  return FALLBACK_PRODUCTS.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

let products = FALLBACK_PRODUCTS;

try {
  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // Use fallback data
}

const product = products.find((p) => p.slug === slug) || products[0];
const related = products.filter((p) => p.id !== product.id && (p.scentFamily === product.scentFamily || p.collectionId === product.collectionId));
---

<Layout title={`${product.name} | Rabbi Azanduna Ltd`}>
  <ProductDetailView
    client:load
    product={product}
    relatedProducts={related}
  />
</Layout>
