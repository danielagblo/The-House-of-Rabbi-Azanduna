---
import Layout from '../../layouts/Layout.astro';
import { ProductDetailView } from '../../components/ProductDetailView';
import { getProductBySlug, getProducts } from '../../lib/db';

const { slug } = Astro.params;

let product = null;
let products: any[] = [];

try {
  if (slug) {
    product = await getProductBySlug(slug);
  }
  products = await getProducts();
} catch (e) {
  console.error('Error fetching product for SSR:', e);
}

if (!product) {
  product = products.find((p) => p.slug === slug) || products[0] || {
    id: 0,
    name: slug ? slug.replace(/-/g, ' ').toUpperCase() : 'Fragrance',
    slug: slug || '',
    price: 0,
    imageUrl: '',
    description: '',
  };
}

const related = products.filter(
  (p) => p.id !== product.id && (p.scentFamily === product.scentFamily || p.collectionId === product.collectionId)
);
---

<Layout title={`${product.name} | Rabbi Azanduna`}>
  <ProductDetailView
    client:load
    product={product}
    relatedProducts={related}
  />
</Layout>
