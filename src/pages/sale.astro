---
import Layout from '../layouts/Layout.astro';
import { SaleView } from '../components/SaleView';
import { getProducts } from '../lib/db';

let products: any[] = [];

try {
  products = await getProducts();
} catch (e) {
  console.error('Error fetching products for SSR sale:', e);
}

const hasDiscounts = products.some(
  (p) => p.compareAtPrice && Number(p.compareAtPrice) > Number(p.price)
);
---

<Layout title={hasDiscounts ? "Sale | Rabbi Azanduna" : "All Products | Rabbi Azanduna"}>
  <SaleView client:load initialProducts={products} />
</Layout>
