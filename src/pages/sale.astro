---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { FALLBACK_PRODUCTS } from '../data/fallbackData';

let products = FALLBACK_PRODUCTS;

try {
  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // fallback
}

// STRICTLY ONLY DISCOUNTED PRODUCTS
const saleProducts = products.filter(
  (p) => p.compareAtPrice && p.compareAtPrice > p.price
);
---

<Layout title="Sale | Rabbi Azanduna Ltd">
  <div class="py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white">
    {/* Clean Header matching Oud Attar reference screenshot */}
    <div class="text-center pt-2 pb-10">
      <h1 class="font-['Barlow',sans-serif] text-3xl sm:text-4xl lg:text-5xl font-extrabold text-black tracking-tight mb-1">
        Bank Holiday Sale
      </h1>
      <p class="font-['Barlow',sans-serif] text-xl sm:text-2xl font-bold text-[#ff2d3b] mb-1">
        Minimum 20% Off!
      </p>
      <p class="text-xs text-gray-500 font-normal">
        Discount applied at checkout
      </p>
    </div>

    {/* Sale Products 3-Column Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {saleProducts.map((product) => (
        <ProductCard client:load product={product} />
      ))}
    </div>

    {/* Product Pagination Progress Section matching reference screenshot */}
    <div class="mt-14 mb-4 text-center flex flex-col items-center justify-center">
      <p class="text-xs sm:text-sm text-gray-600 mb-3 font-['Poppins',sans-serif]">
        You have seen <strong class="text-black font-bold">{saleProducts.length}</strong> out of <strong class="text-black font-bold">{saleProducts.length}</strong> products
      </p>

      {/* Red Progress Bar */}
      <div class="w-48 sm:w-64 h-1 bg-gray-200 rounded-full overflow-hidden mb-6">
        <div class="bg-[#ff2d3b] h-full rounded-full" style="width: 100%;"></div>
      </div>

      <button
        type="button"
        class="bg-[#ff2d3b] hover:bg-[#e0202d] text-white font-bold text-xs sm:text-sm px-8 py-3 rounded-lg shadow-xs transition-all uppercase tracking-wider font-['Barlow_Condensed',sans-serif] cursor-pointer"
      >
        Show more products
      </button>
    </div>
  </div>
</Layout>
