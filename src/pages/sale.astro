---
import Layout from '../layouts/Layout.astro';
import { SaleView } from '../components/SaleView';
import { API_BASE_URL } from '../config/api';

let products: any[] = [];

try {
  const prodRes = await fetch(`${API_BASE_URL}/api/products`);
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // backend offline
}

const hasDiscounts = products.some(
  (p) => p.compareAtPrice && Number(p.compareAtPrice) > Number(p.price)
);
---

<Layout title={hasDiscounts ? "Sale | Rabbi Azanduna Ltd" : "All Products | Rabbi Azanduna Ltd"}>
  <SaleView client:load initialProducts={products} />
</Layout>
