---
import Layout from '../../layouts/Layout.astro';
import type { BlogPost } from '../../types';

let articles: BlogPost[] = [];

try {
  const res = await fetch('http://localhost:8085/api/blogs');
  if (res.ok) {
    const data = await res.json();
    if (data && data.length > 0) {
      articles = data;
    }
  }
} catch (e) {
  // fallback if offline
}
---

<Layout title="Blog | Rabbi Azanduna Ltd">
  <div class="pt-5 sm:pt-6 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white">
    {/* Left-Aligned Heading matching exact reference screenshot */}
    <div class="mb-6 sm:mb-8">
      <h1 class="font-['Barlow',sans-serif] text-[32px] sm:text-[38px] font-extrabold text-black tracking-tight">
        Blog
      </h1>
    </div>

    {/* 3-Column Grid without any shadows or borders matching exact screenshot */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 sm:gap-x-7 sm:gap-y-12">
      {articles.map((art) => (
        <article class="flex flex-col group bg-transparent">
          {/* Card Image: Rounded-xl, No border, No shadow */}
          <a
            href={`/blog/${art.slug}`}
            class="block relative aspect-[16/11] w-full overflow-hidden rounded-xl bg-neutral-100 mb-3.5"
          >
            <img
              src={art.imageUrl}
              alt={art.title}
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
          </a>

          {/* Article Title: Underline only on hover, no color change */}
          <h2 class="font-['Barlow',sans-serif] text-[17px] sm:text-[18px] font-bold text-black leading-snug mb-1.5">
            <a href={`/blog/${art.slug}`} class="hover:underline text-black">
              {art.title}
            </a>
          </h2>

          {/* Excerpt */}
          <p class="text-[13px] text-gray-700 leading-relaxed mb-2.5 font-normal line-clamp-3">
            {art.excerpt}
          </p>

          {/* Red Read More Link */}
          <a
            href={`/blog/${art.slug}`}
            class="text-[#e62b32] hover:underline text-[13px] font-medium inline-flex items-center gap-1 self-start"
          >
            Read more &gt;
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
