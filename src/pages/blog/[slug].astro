---
import Layout from '../../layouts/Layout.astro';
import type { BlogPost } from '../../types';
import { API_BASE_URL } from '../../config/api';

export async function getStaticPaths() {
  const defaultSlugs = [
    "let-oud-be-your-love-language",
    "manifest-your-best-year-with-oud",
    "oud-paired-with-the-unexpected",
    "how-to-apply-pure-oud-perfume-oils",
    "difference-between-cambodian-and-assam-oud",
    "why-non-alcoholic-perfumes-last-longer"
  ];

  try {
    const res = await fetch(`${API_BASE_URL}/api/blogs`);
    if (res.ok) {
      const data: BlogPost[] = await res.json();
      if (data && data.length > 0) {
        return data.map((post) => ({ params: { slug: post.slug } }));
      }
    }
  } catch (e) {
    // fallback
  }

  return defaultSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

let post: BlogPost = {
  id: 1,
  title: "Let Oud Be Your Love Language",
  slug: slug || "let-oud-be-your-love-language",
  excerpt: "Oud is your gentle voice that speaks to your heart. Its deep notes connect with your senses. It whispers devotion and warmth.",
  category: "Rituals of Love",
  readTime: "4 min read",
  imageUrl: "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=1600&q=85",
  published: true,
  sortOrder: 1,
  createdAt: "2026-02-14",
  content: "Oud is your gentle voice that speaks to your heart. Its deep notes connect with your senses. It whispers devotion and warmth.\n\nIn quiet moments, Oud reminds you to treasure your bonds. It brings a soft glow to the air around you. It stirs emotion and invites closeness. When you wear it, you share a secret that sparks affection.\n\nLet it wrap you in a sense of belonging. Offer its soft fragrance to someone dear.\n\nComplete this ritual with our pure essences. It rests on your skin with a delicate touch. It turns each moment into a ritual of love, adding a touch of allure."
};

try {
  const res = await fetch(`${API_BASE_URL}/api/blogs/${slug}`);
  if (res.ok) {
    const data = await res.json();
    if (data && data.title) {
      post = data;
    }
  }
} catch (e) {
  // fallback
}

const paragraphs = post.content ? post.content.split('\n\n') : [post.excerpt];
const currentUrl = `https://rabbiazanduna.com/blog/${post.slug}`;
const shareText = encodeURIComponent(post.title);
---

<Layout title={`${post.title} | Rabbi Azanduna Ltd`}>
  {/* 1. Full-Width Hero Banner with Centered White Title matching exact screenshot */}
  <section class="relative w-full h-[280px] sm:h-[380px] md:h-[460px] flex items-center justify-center overflow-hidden bg-neutral-900">
    <img
      src={post.imageUrl}
      alt={post.title}
      class="absolute inset-0 w-full h-full object-cover object-center opacity-85"
    />
    {/* Dark overlay for contrast */}
    <div class="absolute inset-0 bg-black/45"></div>

    {/* Centered Large Bold Title */}
    <div class="relative z-10 max-w-5xl mx-auto px-3.5 sm:px-6 text-center">
      <h1 class="font-['Barlow',sans-serif] text-2xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
        {post.title}
      </h1>
    </div>
  </section>

  {/* 2. Article Content Body */}
  <article class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8 py-8 sm:py-14 bg-white">
    <div class="space-y-6 text-[14.5px] sm:text-[15.5px] text-[#2c2c2c] leading-relaxed font-normal">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    {/* 3. Share on: Row with social media icons */}
    <div class="mt-12 pt-6 border-t border-gray-100 flex flex-wrap items-center gap-4 sm:gap-6 text-gray-800 text-[13.5px]">
      <span class="font-medium text-black">Share on:</span>

      <div class="flex items-center gap-4">
        {/* WhatsApp */}
        <a
          href={`https://api.whatsapp.com/send?text=${shareText}%20${encodeURIComponent(currentUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on WhatsApp"
          class="hover:opacity-75 transition-opacity text-black"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-1.109-.071-.979-.313-1.898-.946-2.597-1.644-.7-.698-1.332-1.616-1.644-2.595-.133-.416-.116-.798-.071-1.11.05-.333.419-1.026.824-1.17.14-.05.286-.025.405.047l.951 1.157c.108.131.119.321.027.464l-.454.707c.214.381.564.731.945.945l.707-.454c.143-.092.333-.081.464.027l1.157.951c.072.119.097.265.047.405zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.438 5.178L2 22l4.981-1.309C8.423 21.536 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
        </a>

        {/* Facebook */}
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
          class="hover:opacity-75 transition-opacity text-black"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        {/* X / Twitter */}
        <a
          href={`https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(currentUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X"
          class="hover:opacity-75 transition-opacity text-black"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        {/* Pinterest */}
        <a
          href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(currentUrl)}&media=${encodeURIComponent(post.imageUrl)}&description=${shareText}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Pinterest"
          class="hover:opacity-75 transition-opacity text-black"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
          </svg>
        </a>

        {/* Email */}
        <a
          href={`mailto:?subject=${shareText}&body=${encodeURIComponent(currentUrl)}`}
          aria-label="Share via Email"
          class="hover:opacity-75 transition-opacity text-black"
        >
          <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </article>
</Layout>
