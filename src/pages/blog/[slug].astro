---
import Layout from '../../layouts/Layout.astro';
import type { BlogPost } from '../../types';
import { ArrowLeft, Calendar, Clock } from 'lucide-react';

export async function getStaticPaths() {
  const defaultSlugs = [
    "let-oud-be-your-love-language",
    "manifest-your-best-year-with-oud",
    "oud-paired-with-the-unexpected",
    "how-to-apply-pure-oud-perfume-oils",
    "difference-between-cambodian-and-assam-oud",
    "why-non-alcoholic-perfumes-last-longer"
  ];

  try {
    const res = await fetch('http://localhost:8080/api/blogs');
    if (res.ok) {
      const data: BlogPost[] = await res.json();
      if (data && data.length > 0) {
        return data.map((post) => ({ params: { slug: post.slug } }));
      }
    }
  } catch (e) {
    // fallback
  }

  return defaultSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

let post: BlogPost = {
  id: 1,
  title: "Let Oud Be Your Love Language",
  slug: slug || "let-oud-be-your-love-language",
  excerpt: "Oud is your gentle voice that speaks to your heart.",
  category: "Rituals of Love",
  readTime: "4 min read",
  imageUrl: "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=1200&q=85",
  published: true,
  sortOrder: 1,
  createdAt: "2026-02-14",
  content: "In the realm of artisanal perfumery, few essences carry the poetic gravity and romantic intimacy of pure Agarwood. When words fall short, the rich, multifaceted warmth of Oud speaks in whispers of devotion.\n\nUnlike synthetic fragrances that proclaim themselves loudly before fading away, artisanal Oud melds with body chemistry, evolving organically across the hours. It becomes an invisible signature that lingers closely, creating unforgettable olfactory memories.\n\nFor centuries, lovers in the Middle East and the Orient have anointed pulse points with precious Taif Rose and aged Cambodian Oud during celebrations and sacred gatherings. Today, this tradition endures as a sublime way to express tenderness, warmth, and enduring connection."
};

try {
  const res = await fetch(`http://localhost:8080/api/blogs/${slug}`);
  if (res.ok) {
    const data = await res.json();
    if (data && data.title) {
      post = data;
    }
  }
} catch (e) {
  // fallback
}

const paragraphs = post.content ? post.content.split('\n\n') : [post.excerpt];
---

<Layout title={`${post.title} | Rabbi Azanduna Ltd`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-14 bg-white">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs uppercase font-bold text-gray-600 hover:text-[#e62b32] mb-6 transition-colors"
    >
      <ArrowLeft size={14} />
      <span>Back to Blog</span>
    </a>

    <div class="mb-6">
      <h1 class="font-['Barlow',sans-serif] text-2xl sm:text-4xl lg:text-[40px] font-extrabold text-black leading-tight mb-3">
        {post.title}
      </h1>
      <div class="flex items-center gap-4 text-xs text-gray-500 font-medium pb-4 border-b border-gray-200">
        <span class="text-[#e62b32] font-bold uppercase">{post.category}</span>
        <span class="flex items-center gap-1"><Clock size={12} /> {post.readTime || '5 min read'}</span>
      </div>
    </div>

    <div class="aspect-[16/9] rounded-2xl overflow-hidden mb-10 bg-neutral-100">
      <img
        src={post.imageUrl}
        alt={post.title}
        class="w-full h-full object-cover"
      />
    </div>

    <div class="prose prose-neutral max-w-none text-gray-700 text-sm sm:text-base leading-relaxed space-y-6 font-normal">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <h4 class="font-['Barlow',sans-serif] text-xl font-bold text-black uppercase mb-3">
        Experience The Range
      </h4>
      <p class="text-xs text-gray-600 mb-6">Discover our curated artisanal collections and pure oils.</p>
      <a
        href="/collections"
        class="inline-block px-8 py-3 bg-[#e62b32] hover:bg-[#cf2229] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors"
      >
        Shop All Fragrances
      </a>
    </div>
  </div>
</Layout>
