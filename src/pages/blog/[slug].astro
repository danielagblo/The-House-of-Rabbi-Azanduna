---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Calendar, User, Clock } from 'lucide-react';

export async function getStaticPaths() {
  const slugs = [
    "how-to-apply-pure-oud-perfume-oils",
    "difference-between-cambodian-and-assam-oud",
    "why-non-alcoholic-perfumes-last-longer"
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<Layout title="Journal Article | Rabbi Azanduna Ltd">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs uppercase font-bold text-gray-600 hover:text-black mb-8"
    >
      <ArrowLeft size={14} />
      <span>Back to Journal</span>
    </a>

    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-widest text-[#ff2d3b] block mb-2">
        Master Perfumer Insights
      </span>
      <h1 class="font-['Barlow',sans-serif] text-3xl sm:text-5xl font-extrabold text-black leading-tight mb-4">
        The Art of Applying Pure Perfume Oils for 24-Hour Longevity
      </h1>
      <div class="flex items-center gap-4 text-xs text-gray-500 font-medium pb-6 border-b border-gray-200">
        <span class="flex items-center gap-1"><User size={12} /> Master Blender</span>
        <span class="flex items-center gap-1"><Calendar size={12} /> March 2026</span>
        <span class="flex items-center gap-1"><Clock size={12} /> 4 min read</span>
      </div>
    </div>

    <div class="aspect-[16/9] rounded-2xl overflow-hidden mb-10 bg-neutral-100">
      <img
        src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=85"
        alt="Applying Perfume Oils"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="prose prose-neutral max-w-none text-gray-700 text-sm sm:text-base leading-relaxed space-y-6 font-light">
      <p>
        Unlike alcoholic spray perfumes that rely on rapid chemical evaporation to project scent, concentrated botanical perfume oils and pure artisanal Attars work synergistically with the natural heat of your body.
      </p>

      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black pt-4">
        1. Target the Thermal Pulse Points
      </h3>
      <p>
        Apply a drop using the glass rod applicator directly to the inner wrists, behind the earlobes, along the collarbones, and the nape of your neck. The constant heat generated by blood vessels in these areas gently diffuses the heavy resinous molecules of aged Agarwood throughout the day.
      </p>

      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black pt-4">
        2. Never Rub the Wrists Together
      </h3>
      <p>
        Friction breaks down the delicate volatile top notes (such as Taif rose petals or crisp saffron). Instead, gently dab and tap the wrists together to transfer the oil without shearing the botanical accords.
      </p>

      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black pt-4">
        3. Application on Natural Fabrics
      </h3>
      <p>
        Because our pure oils contain 0% alcohol and are distilled to high purity, a gentle dab on the inner lapel of a wool jacket, scarf, or cotton shirt can linger gracefully for up to 3 days.
      </p>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <h4 class="font-['Barlow',sans-serif] text-xl font-bold text-black uppercase mb-3">
        Experience The Range
      </h4>
      <p class="text-xs text-gray-600 mb-6">Discover our curated discovery collections and pure artisanal oils.</p>
      <a
        href="/shop"
        class="inline-block px-8 py-3 bg-[#ff2d3b] hover:bg-[#e0202d] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors"
      >
        Shop All Fragrances
      </a>
    </div>
  </div>
</Layout>
