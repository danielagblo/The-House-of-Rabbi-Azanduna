---
import Layout from '../../layouts/Layout.astro';
import { CollectionsGrid } from '../../components/CollectionsGrid';
import { ProductsCatalog } from '../../components/ProductsCatalog';
import { FALLBACK_COLLECTIONS, FALLBACK_PRODUCTS } from '../../data/fallbackData';

let collections = FALLBACK_COLLECTIONS;
let products = FALLBACK_PRODUCTS;

try {
  const colRes = await fetch('http://localhost:8080/api/collections');
  if (colRes.ok) {
    const data = await colRes.json();
    if (data && data.length > 0) collections = data;
  }

  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // fallback
}

const search = Astro.url.searchParams.get('search') || '';
---

<Layout title="Collections | Rabbi Azanduna Ltd">
  <!-- Collections Storefront matching exact screenshot -->
  <CollectionsGrid client:load collections={collections} title="Collections" />
</Layout>
