---
import Layout from '../../layouts/Layout.astro';
import { ProductCard } from '../../components/ProductCard';
import { getProducts } from '../../lib/db';
import { isAttar } from '../../lib/catalog';
import type { Product } from '../../types';

const search = Astro.url.searchParams.get('search')?.trim() || '';
let products: Product[] = [];

try {
  products = await getProducts();
} catch (e) {
  console.error('Error fetching shop products:', e);
}

if (search) {
  const needle = search.toLowerCase();
  products = products.filter((product) => {
    const notes = (product.notes || []).map((note) => `${note.noteName} ${note.description || ''}`).join(' ');
    const haystack = [
      product.name,
      product.subtitle,
      product.description,
      product.scentFamily,
      product.concentration,
      product.collection?.name,
      notes,
    ].join(' ').toLowerCase();
    return haystack.includes(needle);
  });
}

const perfumes = products.filter((product) => !isAttar(product));
const attars = products.filter((product) => isAttar(product));

const sections = [
  { title: 'Perfumes', items: perfumes },
  { title: 'Attars (Oud Oils)', items: attars },
];
---

<Layout title="Shop | The House of Rabbi Azanduna">
  <div class="pt-8 sm:pt-10 pb-14 px-3.5 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center mb-8 sm:mb-10">
      <h1 class="font-['Barlow_Condensed',sans-serif] text-[34px] sm:text-[46px] font-bold text-[#0B1F3A]">
        Shop
      </h1>
      <p class="mt-2 text-sm text-[#0B1F3A]/70">
        All of our fragrances are faith inspired.
      </p>
      {search && (
        <p class="mt-2 text-sm text-[#0B1F3A]">
          Results for “{search}”
        </p>
      )}
    </div>

    {search && products.length === 0 ? (
      <p class="text-center text-sm text-gray-500">No fragrances match “{search}”.</p>
    ) : (
      sections.map((section) => (
        search && section.items.length === 0 ? null : (
          <section class="mb-12">
            <h2 class="font-['Barlow_Condensed',sans-serif] text-[26px] sm:text-[32px] font-bold text-[#0B1F3A] mb-4 text-center">
              {section.title}
            </h2>
            {section.items.length > 0 ? (
              <div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-x-5 gap-y-8">
                {section.items.map((product) => (
                  <div class="w-full max-w-sm sm:w-[calc((100%-2.5rem)/3)] sm:max-w-none">
                    <ProductCard client:load product={product} />
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-gray-500 text-center">Nothing in this section yet.</p>
            )}
          </section>
        )
      ))
    )}
  </div>
</Layout>
