---
import Layout from '../../layouts/Layout.astro';
import { ProductCard } from '../../components/ProductCard';
import { API_BASE_URL } from '../../config/api';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${API_BASE_URL}/api/collections`);
    if (res.ok) {
      const data = await res.json();
      if (data && data.length > 0) {
        return data.map((c: any) => ({
          params: { slug: c.slug },
        }));
      }
    }
  } catch (e) {
    // fallback build paths
  }

  return [
    { params: { slug: 'oud-perfume-oils' } },
    { params: { slug: 'royal-attars' } },
    { params: { slug: 'extrait-de-parfum' } },
    { params: { slug: 'home-scents' } },
    { params: { slug: 'discovery-sets' } },
  ];
}

const { slug } = Astro.params;

let collections: any[] = [];
let products: any[] = [];

try {
  const colRes = await fetch(`${API_BASE_URL}/api/collections`);
  if (colRes.ok) {
    const data = await colRes.json();
    if (data && data.length > 0) collections = data;
  }

  const prodRes = await fetch(`${API_BASE_URL}/api/products`);
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // backend offline
}

const currentCollection = collections.find((c) => c.slug === slug) || {
  id: 0,
  name: slug ? slug.replace(/-/g, ' ').toUpperCase() : 'Collection',
  slug: slug || '',
  subtitle: 'Curated Artisanal Fragrances'
};

const collectionProducts = products.filter(
  (p) => p.collectionId === currentCollection.id || p.collection?.slug === slug || p.collection?.id === currentCollection.id
);

const hasDiscounts = collectionProducts.some(
  (p) => p.compareAtPrice && Number(p.compareAtPrice) > Number(p.price)
);
---

<Layout title={`${currentCollection.name} | Rabbi Azanduna Ltd`}>
  <div class="pt-4 sm:pt-5 pb-12 px-3.5 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white">
    {/* Clean Centered Header matching Oud Attar reference */}
    <div class="text-center pt-1 pb-5 sm:pb-6">
      <h1 class="font-['Barlow',sans-serif] text-2xl sm:text-4xl lg:text-5xl font-extrabold text-black tracking-tight mb-1">
        {currentCollection.name}
      </h1>
      <p class="font-['Barlow',sans-serif] text-lg sm:text-2xl font-bold text-[#e62b32] mb-1">
        {currentCollection.subtitle || "Curated Artisanal Fragrances"}
      </p>
      {hasDiscounts && (
        <p class="text-xs text-gray-500 font-normal">
          Discount applied at checkout
        </p>
      )}
    </div>

    {/* Products 2-Column Mobile, 3-Column Desktop Grid */}
    {collectionProducts.length > 0 ? (
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 lg:gap-8">
        {collectionProducts.map((product) => (
          <ProductCard client:load product={product} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 px-4 bg-gray-50 border border-gray-200 rounded-xl my-6">
        <p class="text-base font-bold text-gray-800 mb-2 font-['Barlow',sans-serif]">
          No fragrances currently assigned to this collection.
        </p>
        <p class="text-xs text-gray-500 mb-6">
          Use the admin portal to assign products to the {currentCollection.name} collection.
        </p>
        <a
          href="/collections"
          class="inline-block bg-[#e62b32] hover:bg-[#cf2229] text-white font-bold text-xs uppercase tracking-widest px-6 py-3 rounded-lg transition-colors"
        >
          Explore All Collections
        </a>
      </div>
    )}

    {collectionProducts.length > 0 && (
      /* Product Pagination Progress Section matching reference */
      <div class="mt-14 mb-4 text-center flex flex-col items-center justify-center">
        <p class="text-xs sm:text-sm text-gray-600 mb-3 font-['Poppins',sans-serif]">
          You have seen <strong class="text-black font-bold">{collectionProducts.length}</strong> out of <strong class="text-black font-bold">{collectionProducts.length}</strong> products
        </p>

        {/* Red Progress Bar */}
        <div class="w-48 sm:w-64 h-1 bg-gray-200 rounded-full overflow-hidden mb-6">
          <div class="bg-[#e62b32] h-full rounded-full" style="width: 100%;"></div>
        </div>

        <button
          type="button"
          class="bg-[#e62b32] hover:bg-[#cf2229] text-white font-bold text-xs sm:text-sm px-8 py-3 rounded-lg shadow-xs transition-all uppercase tracking-wider font-['Barlow_Condensed',sans-serif] cursor-pointer"
        >
          Show more products
        </button>
      </div>
    )}
  </div>
</Layout>

