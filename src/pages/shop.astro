---
import Layout from '../layouts/Layout.astro';
import { ProductsCatalog } from '../components/ProductsCatalog';
import { FALLBACK_COLLECTIONS, FALLBACK_PRODUCTS } from '../data/fallbackData';

let collections = FALLBACK_COLLECTIONS;
let products = FALLBACK_PRODUCTS;

try {
  const colRes = await fetch('http://localhost:8080/api/collections');
  if (colRes.ok) {
    const data = await colRes.json();
    if (data && data.length > 0) collections = data;
  }

  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // fallback
}

const search = Astro.url.searchParams.get('search') || '';
---

<Layout title="Shop All Fragrances | Rabbi Azanduna Ltd">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white">
    <div class="text-center mb-10">
      <h1 class="font-['Barlow',sans-serif] text-4xl sm:text-5xl font-extrabold text-black uppercase tracking-tight">
        Shop All Fragrances
      </h1>
      <p class="text-xs text-gray-500 mt-2 font-medium">
        Explore our pure Oud perfume oils, high-concentration extrait sprays, and artisanal discovery sets.
      </p>
    </div>

    <ProductsCatalog
      client:load
      initialProducts={products}
      collections={collections}
      initialSearch={search}
    />
  </div>
</Layout>
