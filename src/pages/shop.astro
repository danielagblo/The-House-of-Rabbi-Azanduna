---
import Layout from '../layouts/Layout.astro';
import { CollectionsGrid } from '../components/CollectionsGrid';
import { ProductsCatalog } from '../components/ProductsCatalog';
import { FALLBACK_COLLECTIONS, FALLBACK_PRODUCTS } from '../data/fallbackData';

let collections = FALLBACK_COLLECTIONS;
let products = FALLBACK_PRODUCTS;

try {
  const colRes = await fetch('http://localhost:8080/api/collections');
  if (colRes.ok) {
    const data = await colRes.json();
    if (data && data.length > 0) collections = data;
  }

  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // fallback
}

const search = Astro.url.searchParams.get('search') || '';
---

<Layout title="Shop All Collections | Rabbi Azanduna Ltd">
  <!-- Discovery Collections Grid -->
  <CollectionsGrid client:load collections={collections} title="Discovery Collections" />

  <!-- Products Catalog -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gray-100">
    <div class="mb-8">
      <h2 class="font-['Barlow',sans-serif] text-2xl font-bold text-black uppercase">
        All Fragrances
      </h2>
    </div>

    <ProductsCatalog
      client:load
      initialProducts={products}
      collections={collections}
      initialSearch={search}
    />
  </section>
</Layout>
