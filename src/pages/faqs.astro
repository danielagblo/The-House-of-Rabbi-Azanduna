---
import Layout from '../layouts/Layout.astro';
import type { FAQ } from '../types';
import { API_BASE_URL } from '../config/api';

let faqs: FAQ[] = [];

try {
  const res = await fetch(`${API_BASE_URL}/api/faqs`);
  if (res.ok) {
    const data = await res.json();
    if (data && data.length > 0) {
      faqs = data;
    }
  }
} catch (e) {
  // fallback if offline
}

// Group FAQs by category in order
const categoryOrder = ["Order Enquiries", "Shipping issues", "Returns & Product Care"];
const groupedFaqs: Record<string, FAQ[]> = {};

faqs.forEach((item) => {
  const cat = item.category || "General";
  if (!groupedFaqs[cat]) {
    groupedFaqs[cat] = [];
  }
  groupedFaqs[cat].push(item);
});

// Sorted categories
const categories = Object.keys(groupedFaqs).sort((a, b) => {
  const idxA = categoryOrder.indexOf(a);
  const idxB = categoryOrder.indexOf(b);
  if (idxA !== -1 && idxB !== -1) return idxA - idxB;
  if (idxA !== -1) return -1;
  if (idxB !== -1) return 1;
  return a.localeCompare(b);
});
---

<Layout title="FAQs | Rabbi Azanduna Ltd">
  <div class="pt-5 sm:pt-6 pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white">
    {/* Left-Aligned Heading matching exact reference screenshot */}
    <div class="mb-4 sm:mb-6">
      <h1 class="font-['Barlow',sans-serif] text-[32px] sm:text-[38px] font-extrabold text-black tracking-tight">
        FAQs
      </h1>
    </div>

    {/* Categorized FAQs in clean, readable editorial format */}
    <div class="space-y-10">
      {categories.map((category) => (
        <section>
          {/* Category Title */}
          <h2 class="font-['Barlow',sans-serif] text-xl sm:text-[22px] font-bold text-black mb-5 tracking-tight">
            {category}
          </h2>

          {/* Q&A List */}
          <div class="space-y-6">
            {groupedFaqs[category].map((item) => (
              <div>
                <h3 class="font-bold text-[14px] sm:text-[15px] text-black mb-1.5 leading-snug">
                  {item.question}
                </h3>
                <div class="text-[13px] sm:text-[13.5px] text-gray-800 leading-relaxed font-normal space-y-2">
                  {item.answer.split('\n\n').map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
