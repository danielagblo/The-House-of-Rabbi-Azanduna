---
import Layout from '../layouts/Layout.astro';
import { Award, ShieldCheck, HeartHandshake } from 'lucide-react';
import certImg from '../assets/cert.png';
import { CertificateViewer } from '../components/CertificateViewer';
---

<Layout title="About Us | The House of Rabbi Azanduna Ltd">
  <div class="py-8 sm:py-12 px-3.5 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white font-['Poppins',sans-serif]">
    {/* Hero Header */}
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <h1 class="font-['Barlow',sans-serif] text-3xl sm:text-6xl font-extrabold text-black uppercase tracking-tight mb-3 sm:mb-4">
        The House of Rabbi Azanduna
      </h1>
      <div class="w-16 h-1 bg-[#ff2d3b] mx-auto mb-4 sm:mb-5"></div>
      <p class="text-gray-600 text-xs sm:text-base font-normal leading-relaxed">
        Specialists in 100% pure, non-alcoholic perfume oils, rare aged Oud, and luxury bespoke scents.
      </p>
    </div>

    {/* Narrative Section 1: The Journey */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-14 items-center mb-12 sm:mb-16">
      <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md">
        <img
          src="https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=1000&q=80"
          alt="Artisanal Oud distillation"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-[#ff2d3b]">Our Origins</span>
        <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase">
          The Journey to Extraordinary Scent
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          Our passion for rare perfumery began with a simple discovery: the world of authentic Oriental attars and aged Oud. We were captivated by how pure botanical oils melt into the skin, unfolding layer by layer throughout the day without the harsh sting or quick fade of commercial alcohol sprays.
        </p>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          What started as a personal quest for genuine luxury evolved into The House of Rabbi Azanduna — a dedicated atelier committed to making the most concentrated, evocative, and lasting perfume oils accessible to connoisseurs who demand true quality.
        </p>
      </div>
    </div>

    {/* Narrative Section 2: Pure Philosophy */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-14 items-center mb-12 sm:mb-16 md:flex-row-reverse">
      <div class="space-y-4 order-2 md:order-1">
        <span class="text-xs font-bold uppercase tracking-wider text-[#ff2d3b]">Zero Dilution</span>
        <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase">
          Why 100% Pure Perfume Oils?
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          Most mainstream designer fragrances are composed of up to 90% denatured alcohol and synthetic fillers. While they project loudly for the first few minutes, they rapidly evaporate, leaving behind only faint chemical notes.
        </p>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          At Rabbi Azanduna, we reject dilution. Every flacon is filled with 100% concentrated perfume oil and genuine aged agarwood resins. Because our formulas contain zero alcohol, they are gentle on sensitive skin, deeply nourishing, and produce an intimate, alluring sillage that lasts easily from morning until night.
        </p>
      </div>

      <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md order-1 md:order-2">
        <img
          src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1000&q=80"
          alt="Luxury perfume oil bottles"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    {/* Official Registration & Certificate Section */}
    <div class="bg-neutral-50 border border-neutral-200/80 rounded-2xl p-4 sm:p-10 mb-12 sm:mb-16 shadow-xs">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
        {/* Certificate Image Preview with React interactive modal */}
        <div class="md:col-span-5 flex flex-col items-center justify-center">
          <CertificateViewer client:load imageSrc={certImg.src} />
        </div>

        {/* Meaningful Brand Trust & Authenticity Writing */}
        <div class="md:col-span-7 space-y-4">
          <div>
            <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase tracking-tight mb-2">
              A Certified & Trusted Fragrance House
            </h2>
            <div class="w-12 h-1 bg-[#ff2d3b] mb-4"></div>
          </div>

          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
            At The House of Rabbi Azanduna, authenticity and integrity guide everything we do. Operating as an officially registered limited liability company in Ghana is a reflection of our dedication to transparency, product safety, and customer satisfaction.
          </p>

          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
            We know finding genuine, long-lasting fragrances can be challenging. That is why every perfume oil, artisanal attar, and aged Oud batch we formulate is crafted with uncompromised care, clean non-alcoholic ingredients, and strict attention to detail.
          </p>

          <div class="pt-2 space-y-2.5 text-xs text-gray-800">
            <div class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#ff2d3b] mt-1.5 shrink-0"></span>
              <span><strong>100% Concentrated Pure Oils:</strong> Non-alcoholic, skin-friendly, and formulated for extraordinary 16+ hour longevity.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#ff2d3b] mt-1.5 shrink-0"></span>
              <span><strong>Ethically Sourced Ingredients:</strong> Genuine aged Oud resins, rare botanicals, and hand-selected floral distillates.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#ff2d3b] mt-1.5 shrink-0"></span>
              <span><strong>Verified Customer Confidence:</strong> Safe transactions, premium packaging, and reliable delivery across Ghana and beyond.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Values Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <Award size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Aged Wild Oud
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Sourced ethically from mature Aquilaria trees, aged to perfection for deep, resinous richness.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <ShieldCheck size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Zero Alcohol
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Pure concentrated oils that are non-drying on skin, ensuring an intimate, long-lasting scent trail.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <HeartHandshake size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Bespoke Craftsmanship
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Carefully blended and hand-packaged with uncompromised attention to luxury quality.
        </p>
      </div>
    </div>

    {/* Bottom CTA */}
    <div class="text-center py-10 border-t border-gray-200">
      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black uppercase mb-3">
        Discover Your Signature Scent
      </h3>
      <p class="text-xs text-gray-600 mb-6">Explore our curated collections of pure Oud perfume oils and discovery sets.</p>
      <a
        href="/collections"
        class="inline-block px-8 py-3.5 bg-black hover:bg-[#ff2d3b] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors cursor-pointer"
      >
        Explore The Collections
      </a>
    </div>
  </div>
</Layout>


