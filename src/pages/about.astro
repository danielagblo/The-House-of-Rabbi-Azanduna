---
import Layout from '../layouts/Layout.astro';
import { Award, ShieldCheck, HeartHandshake, ZoomIn, X } from 'lucide-react';
import certImg from '../assets/cert.png';
---

<Layout title="About Us | The House of Rabbi Azanduna Ltd">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white font-['Poppins',sans-serif]">
    {/* Hero Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h1 class="font-['Barlow',sans-serif] text-4xl sm:text-6xl font-extrabold text-black uppercase tracking-tight mb-4">
        The House of Rabbi Azanduna
      </h1>
      <div class="w-16 h-1 bg-[#ff2d3b] mx-auto mb-5"></div>
      <p class="text-gray-600 text-sm sm:text-base font-normal leading-relaxed">
        Specialists in 100% pure, non-alcoholic perfume oils, rare aged Oud, and luxury bespoke scents.
      </p>
    </div>

    {/* Narrative Section */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-16">
      <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md">
        <img
          src="https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=1000&q=80"
          alt="Artisanal Oud distillation"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-4">
        <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase">
          Our Philosophy
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          At The House of Rabbi Azanduna, we believe true luxury in perfumery is measured in purity, patience, and longevity. Most commercial designer fragrances contain up to 90% alcohol that flashes off within minutes.
        </p>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          We reject dilution. Every bottle of our Oud Perfume Oils and Royal Attars is formulated with 100% concentrated botanical extracts, aged Aquilaria wood resins, and pure distillates for a rich, intimate sillage that lasts all day.
        </p>
      </div>
    </div>

    {/* Official Registration & Certificate Section */}
    <div class="bg-neutral-50 border border-neutral-200/80 rounded-2xl p-6 sm:p-10 mb-16 shadow-xs text-center">
      <div class="max-w-2xl mx-auto mb-8">
        <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase tracking-tight mb-2">
          Certificate of Incorporation
        </h2>
        <div class="w-12 h-1 bg-[#ff2d3b] mx-auto mb-3"></div>
        <p class="text-xs sm:text-sm text-gray-600">
          Official registration under the Registrar of Companies, Republic of Ghana.
        </p>
      </div>

      <div class="flex flex-col items-center justify-center">
        <div class="relative group cursor-pointer max-w-sm sm:max-w-md bg-white p-3 rounded-2xl shadow-xl border border-gray-200 hover:shadow-2xl transition-all duration-300">
          <img
            src={certImg.src}
            alt="Official Certificate of Incorporation - The House of Rabbi Azanduna Ltd"
            class="w-full h-auto rounded-xl object-contain shadow-xs"
            id="certThumbnail"
          />
          <div class="absolute inset-0 bg-black/40 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 text-white text-xs font-bold uppercase tracking-wider backdrop-blur-2xs">
            <ZoomIn size={22} />
            <span>Click to view full certificate</span>
          </div>
        </div>
        <span class="text-[11px] text-gray-500 mt-3 font-medium flex items-center gap-1.5">
          <ZoomIn size={13} /> Click to expand high-resolution certificate
        </span>
      </div>
    </div>

    {/* Values Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <Award size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Aged Wild Oud
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Sourced ethically from mature Aquilaria trees, aged to perfection for deep, resinous richness.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <ShieldCheck size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Zero Alcohol
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Pure concentrated oils that are non-drying on skin, ensuring an intimate, long-lasting scent trail.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <HeartHandshake size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Bespoke Craftsmanship
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Carefully blended and hand-packaged with uncompromised attention to luxury quality.
        </p>
      </div>
    </div>

    {/* Bottom CTA */}
    <div class="text-center py-10 border-t border-gray-200">
      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black uppercase mb-3">
        Discover Your Signature Scent
      </h3>
      <p class="text-xs text-gray-600 mb-6">Explore our curated collections of pure Oud perfume oils and discovery sets.</p>
      <a
        href="/collections"
        class="inline-block px-8 py-3.5 bg-black hover:bg-[#ff2d3b] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors cursor-pointer"
      >
        Explore The Collections
      </a>
    </div>
  </div>

  {/* Fullscreen Certificate Lightbox Modal */}
  <div id="certModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="relative max-w-2xl max-h-[90vh] bg-white rounded-2xl p-4 shadow-2xl flex flex-col items-center">
      <button
        id="closeCertModal"
        type="button"
        class="absolute -top-3 -right-3 bg-black text-white hover:bg-[#ff2d3b] rounded-full p-2 shadow-lg cursor-pointer transition-colors"
      >
        <X size={20} />
      </button>
      <img
        src={certImg.src}
        alt="Certificate of Incorporation - The House of Rabbi Azanduna Ltd"
        class="max-h-[82vh] w-auto rounded-lg object-contain"
      />
    </div>
  </div>
</Layout>

<script>
  const certThumb = document.getElementById('certThumbnail');
  const certModal = document.getElementById('certModal');
  const closeBtn = document.getElementById('closeCertModal');

  if (certThumb && certModal && closeBtn) {
    certThumb.addEventListener('click', () => {
      certModal.classList.remove('hidden');
      certModal.classList.add('flex');
    });

    closeBtn.addEventListener('click', () => {
      certModal.classList.add('hidden');
      certModal.classList.remove('flex');
    });

    certModal.addEventListener('click', (e) => {
      if (e.target === certModal) {
        certModal.classList.add('hidden');
        certModal.classList.remove('flex');
      }
    });
  }
</script>

