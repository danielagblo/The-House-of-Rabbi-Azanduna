---
import Layout from '../layouts/Layout.astro';
import { Award, ShieldCheck, HeartHandshake, Sparkles } from 'lucide-react';
---

<Layout title="About Us | Rabbi Azanduna Ltd">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white font-['Poppins',sans-serif]">
    {/* Hero Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-100 text-black text-[10px] uppercase font-bold tracking-widest mb-3">
        <Sparkles size={12} className="text-[#ff2d3b]" />
        Artisanal Haute Parfumerie
      </div>
      <h1 class="font-['Barlow',sans-serif] text-4xl sm:text-6xl font-extrabold text-black uppercase tracking-tight mb-4">
        Rabbi Azanduna Ltd
      </h1>
      <div class="w-16 h-1 bg-[#ff2d3b] mx-auto mb-6"></div>
      <p class="text-gray-600 text-sm sm:text-base font-light leading-relaxed">
        Preserving the timeless heritage of pure Eastern Agarwood distillation while crafting modern luxury perfume oils in England.
      </p>
    </div>

    {/* Narrative Section */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-16">
      <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md">
        <img
          src="https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=1000&q=80"
          alt="Artisanal Oud distillation"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-4">
        <h2 class="font-['Barlow',sans-serif] text-2xl sm:text-3xl font-bold text-black uppercase">
          Our Philosophy
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          At Rabbi Azanduna Ltd, we believe true luxury in perfumery is measured in purity, patience, and longevity. Most commercial designer fragrances contain up to 90% alcohol that flashes off within minutes.
        </p>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-light">
          We reject dilution. Every bottle of our Oud Perfume Oils and Royal Attars is formulated with 100% concentrated botanical extracts, aged Aquilaria wood resins, and pure rose and amber distillates.
        </p>
      </div>
    </div>

    {/* Values Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <Award size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Aged Wild Oud
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Sourced ethically from mature Aquilaria trees in Koh Kong and Assam, aged for unparalleled smoothness.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <ShieldCheck size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          Zero Alcohol
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Non-drying and completely alcohol-free for an intimate, long-lasting scent trail that lasts 16+ hours.
        </p>
      </div>

      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 text-[#ff2d3b] flex items-center justify-center mx-auto mb-4">
          <HeartHandshake size={24} />
        </div>
        <h3 class="font-['Barlow',sans-serif] text-lg font-bold text-black uppercase mb-1">
          London Atelier
        </h3>
        <p class="text-xs text-gray-600 font-light">
          Hand-blended, bottled, and carefully inspected in England with fast worldwide dispatch.
        </p>
      </div>
    </div>

    {/* Bottom CTA */}
    <div class="text-center py-10 border-t border-gray-200">
      <h3 class="font-['Barlow',sans-serif] text-2xl font-bold text-black uppercase mb-3">
        Discover Your Signature Scent
      </h3>
      <p class="text-xs text-gray-600 mb-6">Explore our curated collections of pure Oud perfume oils and discovery sets.</p>
      <a
        href="/collections"
        class="inline-block px-8 py-3.5 bg-black hover:bg-[#ff2d3b] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors"
      >
        Explore The Collections
      </a>
    </div>
  </div>
</Layout>
