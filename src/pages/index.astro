---
import Layout from '../layouts/Layout.astro';
import { CollectionsGrid } from '../components/CollectionsGrid';
import { ProductsCatalog } from '../components/ProductsCatalog';
import { FALLBACK_COLLECTIONS, FALLBACK_PRODUCTS } from '../data/fallbackData';

let collections = FALLBACK_COLLECTIONS;
let products = FALLBACK_PRODUCTS;

try {
  const colRes = await fetch('http://localhost:8080/api/collections');
  if (colRes.ok) {
    const data = await colRes.json();
    if (data && data.length > 0) collections = data;
  }

  const prodRes = await fetch('http://localhost:8080/api/products');
  if (prodRes.ok) {
    const data = await prodRes.json();
    if (data && data.length > 0) products = data;
  }
} catch (e) {
  // fallback
}
---

<Layout title="Rabbi Azanduna Ltd | Discovery Collections">
  <!-- Discovery Collections Grid matching exact screenshot -->
  <CollectionsGrid client:load collections={collections} title="Discovery Collections" />

  <!-- Featured Fragrances Section -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white border-t border-gray-100">
    <div class="text-center mb-10">
      <h2 class="font-['Barlow',sans-serif] text-3xl sm:text-4xl font-extrabold text-black">
        Shop All Perfume Oils & Extrait
      </h2>
      <p class="text-xs text-gray-500 mt-2 font-medium">
        Hand-blended with pure aged Agarwood and natural botanical extracts
      </p>
    </div>

    <ProductsCatalog
      client:load
      initialProducts={products}
      collections={collections}
    />
  </section>
</Layout>
