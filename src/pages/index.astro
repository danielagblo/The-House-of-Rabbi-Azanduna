---
import Layout from '../layouts/Layout.astro';
import AboutStory from '../components/AboutStory.astro';
import { HeroCarousel } from '../components/HeroCarousel';
import { getProducts } from '../lib/db';
import type { Product } from '../types';

let products: Product[] = [];

try {
  products = await getProducts();
} catch (e) {
  console.error('Error fetching homepage fragrances:', e);
}

if (!products.length) {
  try {
    const response = await fetch('https://rabbiazanduna.vercel.app/api/products');
    if (response.ok) {
      const data = await response.json();
      if (Array.isArray(data)) products = data;
    }
  } catch (e) {
    console.error('Error fetching published fragrances for the hero:', e);
  }
}
---

<Layout title="The House of Rabbi Azanduna">
  <HeroCarousel client:load products={products} />
  <AboutStory />
</Layout>
