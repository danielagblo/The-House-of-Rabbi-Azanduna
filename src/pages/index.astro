---
import Layout from '../layouts/Layout.astro';
import { CollectionsGrid } from '../components/CollectionsGrid';
import { getCollections } from '../lib/db';

let collections = [];

try {
  collections = await getCollections();
} catch (e) {
  console.error('Error fetching collections for SSR index:', e);
}
---

<Layout title="Rabbi Azanduna | Collections">
  <!-- Collections Storefront matching exact screenshot -->
  <CollectionsGrid client:load collections={collections} title="Collections" />
</Layout>
