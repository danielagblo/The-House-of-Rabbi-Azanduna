---
import Layout from '../layouts/Layout.astro';
import AboutStory from '../components/AboutStory.astro';
import { HeroCarousel } from '../components/HeroCarousel';
import { getProducts } from '../lib/db';
import type { Product } from '../types';

let products: Product[] = [];

try {
  products = await getProducts();
} catch (e) {
  console.error('Error fetching homepage fragrances:', e);
}

if (!products.length) {
  try {
    const response = await fetch('https://rabbiazanduna.vercel.app/api/products');
    if (response.ok) {
      const data = await response.json();
      if (Array.isArray(data)) products = data;
    }
  } catch (e) {
    console.error('Error fetching published fragrances for the hero:', e);
  }
}
---

<Layout title="The House of Rabbi Azanduna">
  <HeroCarousel client:load products={products} />

  <section class="pt-10 sm:pt-14 pb-4 px-3.5 sm:px-6 lg:px-8 max-w-5xl mx-auto font-['Poppins',sans-serif]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14 items-center">
      <div class="mx-auto w-full max-w-sm aspect-[4/5] rounded-2xl overflow-hidden bg-[#0B1F3A] shadow-md">
        <img
          src="/founder.svg"
          alt="Rabbi Micah Felix Azanduna, Founder"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="text-center md:text-left">
        <span class="text-xs font-bold uppercase tracking-wider text-[#0B1F3A]">Founder</span>
        <h1 class="font-['Barlow',sans-serif] text-3xl sm:text-5xl font-extrabold text-[#0B1F3A] uppercase tracking-tight mt-3">
          Sacred Wisdom, Bottled
        </h1>
        <div class="w-16 h-1 bg-[#0B1F3A] mx-auto md:mx-0 mt-4 mb-5 sm:mb-6"></div>
        <div class="space-y-4 text-[#0B1F3A]/80 text-xs sm:text-base leading-relaxed">
          <p>
            Welcome to The House of Rabbi Azanduna—a luxury Ghanaian perfume house where ancient spiritual heritage meets haute parfumerie.
          </p>
          <p>
            Founded by Rabbi Micah Felix Azanduna, our family-owned atelier crafts fine fragrances inspired by biblical wisdom, sacred doctrines, and timeless philosophy. Operating from Ghana, we blend precious resins, rare botanicals, and rich aromatics to transform scent into a deeply personal ritual of reverence, elegance, and purpose.
          </p>
          <p class="text-[#0B1F3A] font-medium">
            Discover fragrances with soul, crafted for the extraordinary.
          </p>
        </div>
      </div>
    </div>
  </section>

  <AboutStory />
</Layout>
