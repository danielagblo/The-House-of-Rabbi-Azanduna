---
import '../styles/global.css';
import { AnnouncementBar } from '../components/AnnouncementBar';
import { Navbar } from '../components/Navbar';
import { CartDrawer } from '../components/CartDrawer';
import { QuickViewModal } from '../components/QuickViewModal';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rabbi Azanduna | Artisanal Pure Oud Perfume Oils & Sprays",
  description = "Specialists in infusing rich botanical perfume oils with our signature aged Oud to deliver an unforgettable, long-lasting aroma."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-white text-[#0B1F3A]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts Preconnect & Stylesheets (Montserrat, Barlow, Barlow Condensed, Barlow Semi Condensed, Oswald, Poppins) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow+Semi+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600;700;800;900&family=Montserrat:wght@500;600;700;800&family=Oswald:wght@500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-white text-[#0B1F3A] selection:bg-[#0B1F3A] selection:text-white font-['Poppins',sans-serif]">
    <!-- Red Top Announcement Bar -->
    <AnnouncementBar client:load />

    <!-- Clean White Navbar matching screenshot -->
    <Navbar client:load />

    <!-- Main Content -->
    <main class="flex-1 bg-white">
      <slot />
    </main>

    <!-- Slide-over Cart Drawer -->
    <CartDrawer client:idle />

    <!-- Quick View Modal -->
    <QuickViewModal client:idle />

    <!-- Footer -->
    <Footer />

    <a
      href="https://wa.me/233554405880?text=Hello%2C%20The%20House%20of%20Rabbi%20Azanduna."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
      class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg hover:bg-[#1ebe5d] transition-colors"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
        <path d="M20.5 3.5A11 11 0 0 0 2.1 17.8L1 23l5.4-1.1A11 11 0 0 0 20.5 3.5zm-8.5 17a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-3.2.7.7-3.1-.2-.3A9.1 9.1 0 1 1 12 20.5zm5-6.8c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.2-.3a.5.5 0 0 0 0-.5c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4 15 15 0 0 0 1.5.6 3.6 3.6 0 0 0 1.7.1 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"/>
      </svg>
    </a>
  </body>
</html>
